{
  "name": "planqer-frontend",
  "version": "0.9.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "axios": "^1.20.0",
    "i18next": "^26.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "three": "0.186.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:static": "VITE_PLANQER_MODE=static PUBLIC_URL=/Planqer/app/ BUILD_PATH=build-static vite build",
    "test": "vitest run",
    "test:parity": "vitest run --config vitest.parity.config.mjs",
    "test:runtime-browser": "playwright test --config playwright.runtime.config.js",
    "test:analytics": "playwright test --config playwright.analytics.config.js",
    "test:demo": "playwright test --config playwright.demo.config.js",
    "dev": "vite",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.55.0",
    "postcss": "^8.5.30",
    "source-map-js": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
