{
  "name": "partsible-frontend",
  "version": "0.15.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "axios": "^1.21.1",
    "i18next": "^27.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "three": "0.187.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:static": "VITE_PARTSIBLE_MODE=static PUBLIC_URL=/ BUILD_PATH=build-static vite build",
    "test": "vitest run",
    "test:parity": "vitest run --config vitest.parity.config.mjs",
    "test:runtime-browser": "playwright test --config playwright.runtime.config.js",
    "test:analytics": "playwright test --config playwright.analytics.config.js",
    "test:lite": "playwright test --config playwright.lite.config.js",
    "dev": "vite",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright": "^1.55.0",
    "postcss": "^8.5.33",
    "source-map-js": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
