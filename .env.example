# Copy this file to .env and fill in the values you need.
# Localhost works with no configuration at all - everything below is only
# needed for a hosted, proxied, or otherwise non-default deployment.
# See docs/reference/configuration.md for details on each variable.

# --- Backend ---

# Selects the release image tag to pull from GitHub Container Registry
# (docker-compose.release.yml only). Defaults to "latest"; pin a version
# (e.g. 0.2.0) for reproducible installs.
PLANQER_VERSION=

# Signs login sessions. Generate with: openssl rand -hex 32
# Set this and keep it stable across restarts, or every restart invalidates
# existing sessions.
SECRET_KEY=

# Comma-separated origins allowed to call the API, in addition to
# localhost/127.0.0.1. Required if you access Planqer from a LAN IP or a
# hostname, e.g.:
# PLANQER_CORS_ORIGINS=http://192.168.1.50:3001,https://planqer.example.com
PLANQER_CORS_ORIGINS=

# --- Frontend ---

# The hostname you serve Planqer on. Required behind a reverse proxy on any
# hostname other than localhost/127.0.0.1, or requests get "Blocked request".
PLANQER_HOST=

# Only needed if the API is not reachable at the same origin as the app, or
# at port 8002 on the same host. An origin, no path.
VITE_API_URL=

# --- Ports (only if 8002/3001 conflict with something else on your host) ---

BACKEND_PORT=
FRONTEND_PORT=
