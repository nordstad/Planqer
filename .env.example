# Copy this file to .env and fill in the values you need.
# Localhost works with no configuration at all - everything below is only
# needed for a hosted, proxied, or otherwise non-default deployment.
# See docs/reference/configuration.md for details on each variable.

# --- Backend ---

# Selects the release image tag to pull from GitHub Container Registry
# (docker-compose.release.yml only). Defaults to "latest"; pin a version
# (e.g. 0.14.0) for reproducible installs.
PARTSIBLE_VERSION=

# Optional explicit signing key for login sessions. If empty, Partsible generates
# and persists one in the backend data volume. Set this for multiple backend
# replicas or externally managed secrets.
SECRET_KEY=

# Protects first-account registration when the API is reached through a
# network or reverse proxy. Generate with: openssl rand -hex 32
PARTSIBLE_SETUP_SECRET=

# Set to true to remove accounts and sign-in (single user). Refused unless the
# app is bound to this computer only; see PARTSIBLE_ALLOW_OPEN_LAN in the docs.
# docker-compose.simple.yml sets this for you.
PARTSIBLE_SINGLE_USER=

# Comma-separated origins allowed to call the API, in addition to
# localhost/127.0.0.1. Required if you access Partsible from a LAN IP or a
# hostname, e.g.:
# PARTSIBLE_CORS_ORIGINS=http://192.168.1.50:3001,https://partsible.example.com
PARTSIBLE_CORS_ORIGINS=

# Default country of the built-in product catalogue: SE (Sweden) or NO (Norway).
# Everyone can pick their own in the app (Automatic follows their language); this
# is what they get when nothing points to a country. Empty: the generic catalogue.
PARTSIBLE_CATALOGUE_COUNTRY=

# --- Frontend ---

# The hostname you serve Partsible on. Required behind a reverse proxy on any
# hostname other than localhost/127.0.0.1, or requests get "Blocked request".
PARTSIBLE_HOST=

# Only needed if the API is not reachable at the same origin as the app, or
# at port 8002 on the same host. An origin, no path.
VITE_API_URL=

# --- Ports (only if 8002/3001 conflict with something else on your host) ---

BACKEND_PORT=
FRONTEND_PORT=
